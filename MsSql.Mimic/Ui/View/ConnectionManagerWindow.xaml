<mah:MetroWindow
    x:Class="MsSql.Mimic.Ui.View.ConnectionManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MsSql.Mimic.Ui.Behaviors"
    xmlns:converter="clr-namespace:MsSql.Mimic.Ui.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:MsSql.Mimic.Ui.ViewModel"
    Title="Connections"
    Width="810"
    Height="480"
    MinWidth="810"
    MinHeight="480"
    d:DataContext="{d:DesignInstance Type=viewModel:ConnectionManagerWindowViewModel}"
    mah:DialogParticipation.Register="{Binding}"
    Background="#090909"
    BorderBrush="#D32F2F"
    GlowBrush="#D32F2F"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <converter:NegateBoolConverter x:Key="NegateBoolConverter" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StatusBar Background="#111111" DockPanel.Dock="Bottom">
            <StatusBarItem
                HorizontalAlignment="Center"
                Content="{Binding InfoText}"
                Foreground="{Binding InfoTextColor}" />
        </StatusBar>

        <Grid Margin="5" ColumnDefinitions="300,3*">
            <Border Grid.Column="0" Style="{StaticResource BorderStyle}">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Label
                        Grid.Row="0"
                        Content="Connections"
                        Style="{StaticResource Headline}" />

                    <Separator Grid.Row="1" />

                    <Button
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        Command="{Binding NewConnectionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                Kind="DatabasePlusOutline" />
                            <TextBlock Text="New connection" />
                        </StackPanel>
                    </Button>

                    <DataGrid
                        Grid.Row="3"
                        IsReadOnly="True"
                        ItemsSource="{Binding Connections}"
                        SelectedItem="{Binding SelectedConnection}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Server}"
                                Header="Server" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Database}"
                                Header="Database" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding LastUsed, StringFormat={}{0:yyyy-MM-dd}}"
                                Header="Last used" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

            <Border Grid.Column="2" Style="{StaticResource BorderStyle}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Label
                        Grid.Row="0"
                        Content="Connection details"
                        Style="{StaticResource Headline}" />

                    <Separator Grid.Row="1" />

                    <Grid
                        Margin="5"
                        ColumnDefinitions="Auto,*"
                        Row="2"
                        RowDefinitions="Auto,Auto,32,Auto,Auto,32,32,Auto,*">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Server:" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding EditedConnection.Server, UpdateSourceTrigger=PropertyChanged}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Database:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding EditedConnection.Database, UpdateSourceTrigger=PropertyChanged}" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="Integrated security:" />
                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="1"
                            IsChecked="{Binding EditedConnection.UseIntegratedSecurity}" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            Content="Username:" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            IsEnabled="{Binding EditedConnection.UseIntegratedSecurity, Converter={StaticResource NegateBoolConverter}}" />

                        <Label
                            Grid.Row="4"
                            Grid.Column="0"
                            Content="Password:" />
                        <PasswordBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="3"
                            behaviors:PasswordBoxAssistant.BindPassword="True"
                            behaviors:PasswordBoxAssistant.BoundPassword="{Binding EditedConnection.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding EditedConnection.UseIntegratedSecurity, Converter={StaticResource NegateBoolConverter}}" />

                        <Label
                            Grid.Row="5"
                            Grid.Column="0"
                            Content="Trust server certificate:" />
                        <CheckBox
                            Grid.Row="5"
                            Grid.Column="1"
                            IsChecked="{Binding EditedConnection.TrustServerCertificates}" />

                        <Label
                            Grid.Row="6"
                            Grid.Column="0"
                            Content="Encrypt:" />
                        <CheckBox
                            Grid.Row="6"
                            Grid.Column="1"
                            IsChecked="{Binding EditedConnection.Encrypt}" />

                        <Label
                            Grid.Row="7"
                            Grid.Column="0"
                            Content="Application intent:" />
                        <ComboBox
                            Grid.Row="7"
                            Grid.Column="1"
                            ItemsSource="{Binding ApplicationIntents}"
                            SelectedItem="{Binding EditedConnection.ApplicationIntent}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="90"
                            Command="{Binding TestConnectionCommand}"
                            Content="Test"
                            Foreground="LightGreen" />

                        <Button
                            Width="90"
                            Command="{Binding SaveConnectionCommand}"
                            Content="Save"
                            IsEnabled="{Binding ButtonSaveEnabled}" />

                        <Button
                            Width="90"
                            Command="{Binding DeleteConnectionCommand}"
                            Content="Delete"
                            Foreground="OrangeRed" />

                        <Button
                            Width="90"
                            Command="{Binding ConnectCommand}"
                            Content="Connect"
                            Foreground="LightBlue"
                            IsEnabled="{Binding ButtonConnectEnabled}" />

                        <Button
                            Width="90"
                            Command="{Binding CloseCommand}"
                            Content="Close"
                            Foreground="Orange" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>

</mah:MetroWindow>
