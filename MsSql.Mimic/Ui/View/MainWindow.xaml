<mah:MetroWindow
    x:Class="MsSql.Mimic.Ui.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:MsSql.Mimic.Ui.Enums"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:MsSql.Mimic.Ui.ViewModel"
    Title="{Binding Title}"
    Width="1200"
    Height="600"
    MinWidth="1200"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
    mah:DialogParticipation.Register="{Binding}"
    Background="#090909"
    BorderBrush="#D32F2F"
    GlowBrush="#D32F2F"
    Icon="../../Assets/TaskbarIcon.ico"
    NonActiveGlowBrush="#D32F2F"
    ResizeMode="CanResizeWithGrip"
    TitleCharacterCasing="Normal"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  Title  -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="10,3,3,3"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{Binding}" />
                <TextBlock
                    Margin="10,3,3,3"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontStyle="Italic"
                    Foreground="LightGray"
                    Text="SQL to C#" />
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <!--  Titlebar buttons - top right  -->
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <ToggleButton x:Name="ToggleButtonStats" ToolTip="Shows the stats">
                <iconPacks:PackIconBootstrapIcons Kind="BarChartLineFill" />
            </ToggleButton>

            <Button Command="{Binding OpenOnGithubCommand}" ToolTip="MsSql.Mimic on Github">
                <iconPacks:PackIconBootstrapIcons Kind="Github" />
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <!--  Stats flyout  -->
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout
                Width="300"
                Header="Statistics"
                IsOpen="{Binding ElementName=ToggleButtonStats, Path=IsChecked, Mode=TwoWay}"
                Position="Right">
                <Border Style="{StaticResource BorderStyle}">
                    <Grid Margin="20" RowDefinitions="Auto,24,Auto,*">
                        <StackPanel Grid.Row="0">
                            <TextBlock
                                FontFamily="{StaticResource AppFont}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Total" />

                            <Separator />

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Content="- Generated classes:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Statistics.TotalGeneratedClassCount, StringFormat=N0}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Content="- Different tables:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Statistics.TotalGeneratedTableCount, StringFormat=N0}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock
                                FontFamily="{StaticResource AppFont}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Current session" />

                            <Separator />

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Content="- Generated classes:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Statistics.SessionGeneratedClassCount, StringFormat=N0}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Content="- Different tables:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Statistics.SessionGeneratedTableCount, StringFormat=N0}" />
                            </Grid>
                        </StackPanel>

                        <TextBlock
                            Grid.Row="3"
                            Margin="0,30,3,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontFamily="Consolas"
                            Foreground="#D0D0D0"
                            Text="{Binding Statistics.InfoMessage}" />
                    </Grid>
                </Border>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>

    <!--  Main content  -->
    <DockPanel LastChildFill="True">
        <StatusBar Background="#111111" DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0" Content="{Binding ConnectionInfo}" />

            <StatusBarItem
                Grid.Column="1"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                Content="{Binding InfoText}"
                Foreground="{Binding InfoTextColor}" />

            <StatusBarItem
                Grid.Column="2"
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                Content="{Binding VersionNumber}"
                Foreground="#FF3B30" />
        </StatusBar>

        <Grid RowDefinitions="Auto,*">

            <Path
                Grid.Row="0"
                Grid.RowSpan="2"
                Margin="50"
                Data="M2859 8820 c-270 -183 -1027 -698 -1294 -880 -66 -45 -295 -201 -510 -346 -214 -146 -437 -298 -495 -337 l-105 -72 -3 -1911 -2 -1911 152 -105 c84 -58 228 -157 320 -219 312 -213 473 -323 698 -478 124 -85 308 -212 410 -281 261 -178 444 -304 600 -413 261 -182 641 -437 651 -437 11 0 86 45 441 266 114 71 310 192 434 269 125 77 331 205 458 283 127 79 256 158 286 176 30 18 92 56 137 84 l82 52 68 -47 c71 -49 1103 -737 1472 -982 l214 -142 51 34 c28 19 137 95 242 168 599 418 1490 1037 1804 1254 113 78 313 217 445 310 132 93 263 184 290 204 28 19 60 44 73 55 l23 21 -2 1785 c-2 982 -6 1823 -9 1870 l-5 85 -380 257 c-209 141 -454 307 -545 369 -91 61 -304 205 -475 320 -170 114 -496 333 -724 486 -228 153 -419 279 -425 281 -7 1 -63 -33 -126 -76 -64 -43 -309 -208 -545 -367 -444 -298 -525 -352 -1103 -744 l-342 -232 -98 67 c-53 37 -124 86 -157 109 -283 196 -1686 1153 -1784 1217 -40 26 -77 48 -81 48 -4 0 -68 -41 -141 -90z m476 -1145 c50 -33 169 -115 265 -181 166 -114 423 -289 932 -635 l227 -154 1 -327 c0 -181 -3 -328 -7 -328 -5 0 -60 39 -124 88 -64 48 -165 122 -225 164 -60 42 -156 112 -214 154 -230 169 -584 427 -740 539 -91 65 -230 166 -310 225 -157 115 -301 213 -305 208 -1 -2 -5 -1054 -9 -2338 -4 -1284 -8 -2336 -10 -2337 -1 -1 -67 42 -147 96 -79 55 -261 179 -404 276 -143 97 -372 253 -510 346 -137 94 -305 207 -371 252 l-121 82 -8 1463 c-6 1230 -5 1466 6 1478 8 7 401 272 873 588 l860 575 125 -86 c69 -48 167 -114 216 -148z m4773 -379 l872 -581 -1 -720 c-1 -396 -5 -1051 -8 -1455 l-6 -735 -250 -170 c-137 -94 -322 -220 -410 -280 -88 -60 -190 -130 -227 -155 -188 -128 -443 -304 -547 -377 -64 -45 -119 -83 -123 -83 -5 0 -8 1053 -8 2340 l0 2341 -62 -44 c-66 -47 -206 -146 -404 -286 -66 -47 -150 -108 -189 -136 -38 -28 -180 -130 -315 -225 -135 -96 -381 -273 -548 -394 -167 -122 -324 -236 -350 -254 l-47 -32 -6 27 c-4 16 -7 159 -8 319 -1 264 1 294 17 312 14 18 459 323 1172 805 96 65 260 176 364 247 105 71 195 126 200 123 6 -3 404 -267 884 -587z m-3518 -2312 c206 -154 405 -301 442 -327 l66 -47 174 125 c95 68 225 163 288 210 63 47 201 148 305 225 105 76 284 209 400 294 115 85 213 152 217 149 9 -5 11 -3133 3 -3133 -3 0 -18 8 -33 19 -15 10 -119 78 -232 151 -113 73 -241 157 -285 185 -352 232 -812 528 -820 528 -5 0 -66 -36 -135 -80 -69 -44 -237 -151 -375 -238 -137 -87 -286 -181 -330 -210 -85 -56 -349 -222 -453 -286 -34 -22 -67 -39 -72 -39 -7 0 -10 544 -10 1555 l0 1555 238 -178 c130 -99 406 -305 612 -458z"
                Fill="#D32F2F"
                Stretch="Uniform" />

            <!--  Connection  -->
            <Border
                Grid.Row="0"
                Opacity=".97"
                Style="{StaticResource BorderStyle}">
                <Grid ColumnDefinitions="Auto,350,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Content="Connection"
                        Style="{StaticResource Headline}" />

                    <Separator
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="7" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Content="Connection:" />

                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        ItemsSource="{Binding Connections, Mode=OneWay}"
                        SelectedItem="{Binding SelectedConnection}" />

                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Width="75"
                        Command="{Binding ConnectCommand}"
                        Content="Connect"
                        Foreground="LightGreen"
                        ToolTip="Establishes a connection and loads the table data." />

                    <Button
                        Grid.Row="2"
                        Grid.Column="3"
                        Width="75"
                        Command="{Binding ManageConnectionsCommand}"
                        Content="Manage..."
                        Foreground="OrangeRed"
                        ToolTip="Opens a window through which connections can be managed." />
                </Grid>
            </Border>

            <!--  Content  -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="250,600,*"
                IsEnabled="{Binding Connected}"
                Opacity=".97">
                <!--  Tables  -->
                <Border
                    Grid.Column="0"
                    MinWidth="200"
                    Style="{StaticResource BorderStyle}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,33">
                        <Label
                            Grid.Row="0"
                            Content="Tables"
                            Style="{StaticResource Headline}">
                            <Label.InputBindings>
                                <MouseBinding Command="{Binding ShowInfoCommand}" MouseAction="LeftClick" />
                            </Label.InputBindings>
                        </Label>

                        <Separator Grid.Row="1" />

                        <DataGrid
                            Grid.Row="2"
                            ItemsSource="{Binding Tables}"
                            SelectedItem="{Binding SelectedTable}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Schema}"
                                    Header="Schema" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Separator Grid.Row="3" />

                        <TextBox
                            Grid.Row="4"
                            mah:TextBoxHelper.Watermark="Filter..."
                            Style="{StaticResource TextBoxFilter}"
                            Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <!--  Columns  -->
                <Border Grid.Column="1" Style="{StaticResource BorderStyle}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                        <Label
                            Grid.Row="0"
                            Content="Columns"
                            Style="{StaticResource Headline}" />

                        <Separator Grid.Row="1" />

                        <DataGrid
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            ItemsSource="{Binding Columns}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn
                                    Width="50"
                                    Binding="{Binding IsIncluded}"
                                    Header="Use" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding ColumnName}"
                                    Header="Column"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Property" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding CSharpTypeName}"
                                    Header="Type"
                                    IsReadOnly="True" />
                                <DataGridCheckBoxColumn
                                    Width="50"
                                    Binding="{Binding IsPrimaryKey}"
                                    Header="Key" />
                                <DataGridCheckBoxColumn
                                    Width="60"
                                    Binding="{Binding IsNullable}"
                                    Header="Null" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Separator Grid.Row="3" />

                        <StackPanel
                            Grid.Row="4"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <Button
                                Width="90"
                                Command="{Binding SelectColumnsCommand}"
                                CommandParameter="{x:Static enums:ColumnSelectionMode.All}"
                                Content="Select all"
                                Foreground="LightGreen" />
                            <Button
                                Width="90"
                                Command="{Binding SelectColumnsCommand}"
                                CommandParameter="{x:Static enums:ColumnSelectionMode.None}"
                                Content="Select none"
                                Foreground="LightSalmon" />
                            <Button
                                Width="90"
                                Command="{Binding ResetColumnChangesCommand}"
                                Content="Reset"
                                Foreground="OrangeRed"
                                ToolTip="Resets all changes made to the columns." />
                        </StackPanel>

                        <Button
                            Grid.Row="4"
                            Width="75"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveAliasesCommand}"
                            Content="Save" />
                    </Grid>
                </Border>

                <!--  Code  -->
                <Border Grid.Column="2" Style="{StaticResource BorderStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <Label
                            Grid.Row="0"
                            Content="Code"
                            Style="{StaticResource Headline}" />

                        <Separator Grid.Row="1" />

                        <Grid
                            Grid.Row="2"
                            ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="Namespace:" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding NamespaceName, UpdateSourceTrigger=PropertyChanged}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Content="Class:" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Content="Property accessor:" />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                ItemsSource="{Binding Accessors}"
                                SelectedItem="{Binding SelectedAccessor}" />

                            <CheckBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Content="Use EF Core attributes"
                                IsChecked="{Binding UseEfCoreAttributes}" />

                            <CheckBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Content="Generate summary"
                                IsChecked="{Binding GenerateSummary}" />
                        </Grid>

                        <StackPanel
                            Grid.Row="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Width="75"
                                Command="{Binding GenerateCodeCommand}"
                                Content="Generate" />
                        </StackPanel>

                        <Separator Grid.Row="4" />

                        <Label
                            Grid.Row="5"
                            Content="C# Class code"
                            Style="{StaticResource Headline}" />

                        <avalonedit:TextEditor
                            x:Name="TextEditor"
                            Grid.Row="6"
                            Document="{Binding GeneratedCodeDocument}"
                            FontFamily="Hack,Consolas"
                            FontSize="12"
                            IsReadOnly="True"
                            ShowLineNumbers="True"
                            SyntaxHighlighting="C#" />

                        <Separator Grid.Row="7" />

                        <StackPanel
                            Grid.Row="8"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Width="75"
                                Command="{Binding CopyCodeCommand}"
                                Content="Copy" />
                            <Button
                                Width="75"
                                Command="{Binding SaveCodeCommand}"
                                Content="Save" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
