<mah:MetroWindow
    x:Class="MsSql.Mimic.Ui.ConnectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MsSql.Mimic.Ui.Behaviors"
    xmlns:converter="clr-namespace:MsSql.Mimic.Ui.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MsSql.Mimic.Ui.ViewModel"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:MsSql.Mimic.Ui.ViewModel"
    Title="{Binding Title}"
    Width="400"
    Height="350"
    mah:DialogParticipation.Register="{Binding}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewModel:ConnectionWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converter:NegateBoolConverter x:Key="NegateBoolConverter" />
    </Window.Resources>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,32,Auto,Auto,32,32,Auto,*,Auto">
        <Label
            Grid.Row="0"
            Grid.Column="0"
            Content="Server:" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Text="{Binding Connection.Server, UpdateSourceTrigger=PropertyChanged}" />

        <Label
            Grid.Row="1"
            Grid.Column="0"
            Content="Database:" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Text="{Binding Connection.Database, UpdateSourceTrigger=PropertyChanged}" />

        <Label
            Grid.Row="2"
            Grid.Column="0"
            Content="Integrated security:" />
        <CheckBox
            Grid.Row="2"
            Grid.Column="1"
            IsChecked="{Binding Connection.UseIntegratedSecurity}" />

        <Label
            Grid.Row="3"
            Grid.Column="0"
            Content="Username:" />
        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            IsEnabled="{Binding Connection.UseIntegratedSecurity, Converter={StaticResource NegateBoolConverter}}"
            Text="{Binding Connection.UserName, UpdateSourceTrigger=PropertyChanged}" />

        <Label
            Grid.Row="4"
            Grid.Column="0"
            Content="Password:" />
        <PasswordBox
            Grid.Row="4"
            Grid.Column="1"
            Margin="3"
            behaviors:PasswordBoxAssistant.BindPassword="True"
            behaviors:PasswordBoxAssistant.BoundPassword="{Binding Connection.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding Connection.UseIntegratedSecurity, Converter={StaticResource NegateBoolConverter}}" />

        <Label
            Grid.Row="5"
            Grid.Column="0"
            Content="Trust server certificate:" />
        <CheckBox
            Grid.Row="5"
            Grid.Column="1"
            IsChecked="{Binding Connection.TrustServerCertificates}" />

        <Label
            Grid.Row="6"
            Grid.Column="0"
            Content="Encrypt:" />
        <CheckBox
            Grid.Row="6"
            Grid.Column="1"
            IsChecked="{Binding Connection.Encrypt}" />

        <Label
            Grid.Row="7"
            Grid.Column="0"
            Content="Application intent:" />
        <ComboBox
            Grid.Row="7"
            Grid.Column="1"
            ItemsSource="{Binding ApplicationIntents}"
            SelectedItem="{Binding Connection.ApplicationIntent}" />

        <Separator
            Grid.Row="8"
            Grid.Column="0"
            Grid.ColumnSpan="2" />

        <Button
            Grid.Row="9"
            Grid.Column="0"
            Width="75"
            HorizontalAlignment="Left"
            Content="Reset" />

        <StackPanel
            Grid.Row="9"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="75"
                Command="{Binding TryConnectCommand}"
                Content="Test"
                Foreground="LightGreen" />
            <Button
                Width="75"
                Command="{Binding SaveConnectionCommand}"
                Content="Save"
                IsEnabled="{Binding ButtonSaveEnabled, Mode=OneWay}" />
            <Button
                Width="75"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                Foreground="OrangeRed" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
