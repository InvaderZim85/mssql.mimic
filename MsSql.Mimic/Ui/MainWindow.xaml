<mah:MetroWindow
    x:Class="MsSql.Mimic.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:MsSql.Mimic.Ui"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:MsSql.Mimic.Ui.ViewModel"
    Title="MsSql.ClassGenerator"
    Width="1200"
    Height="600"
    MinWidth="1200"
    MinHeight="600"
    mah:DialogParticipation.Register="{Binding}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewModel:MainWindowViewModel />
    </Window.DataContext>

    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Server / Database" />

            <StatusBarItem
                HorizontalAlignment="Stretch"
                Content="{Binding InfoText}"
                Foreground="{Binding InfoTextColor}" />

            <StatusBarItem
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                Content="Version number" />
        </StatusBar>

        <Grid RowDefinitions="Auto,*">
            <!--  Connection  -->
            <Border Grid.Row="0" Style="{StaticResource BorderStyle}">
                <Grid ColumnDefinitions="Auto,400,Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Content="Connection"
                        Style="{StaticResource Headline}" />

                    <Separator
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="7" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Content="Connection:" />

                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        ItemsSource="{Binding Connections, Mode=OneWay}"
                        SelectedItem="{Binding SelectedConnection}" />

                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Width="30"
                        Command="{Binding NewConnectionCommand}"
                        Foreground="LightGreen"
                        ToolTip="Adds a new connection">
                        <iconPacks:PackIconMaterial Kind="DatabasePlusOutline" />
                    </Button>

                    <Button
                        Grid.Row="2"
                        Grid.Column="3"
                        Width="30"
                        Command="{Binding EditConnectionCommand}"
                        Foreground="Orange"
                        ToolTip="Edits the selected connection">
                        <iconPacks:PackIconMaterial Kind="DatabaseEditOutline" />
                    </Button>

                    <Button
                        Grid.Row="2"
                        Grid.Column="4"
                        Width="30"
                        Command="{Binding DeleteConnectionCommand}"
                        Foreground="OrangeRed"
                        ToolTip="Deletes the selected connection">
                        <iconPacks:PackIconMaterial Kind="DatabaseRemoveOutline" />
                    </Button>

                    <Button
                        Grid.Row="2"
                        Grid.Column="5"
                        Command="{Binding ConnectCommand}"
                        Content="Connect" />
                </Grid>
            </Border>

            <!--  Content  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Tables  -->
                <Border
                    Grid.Column="0"
                    MinWidth="200"
                    Style="{StaticResource BorderStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <Label
                            Grid.Row="0"
                            Content="Tables"
                            Style="{StaticResource Headline}" />

                        <Separator Grid.Row="1" />

                        <TextBox
                            Grid.Row="2"
                            mah:TextBoxHelper.Watermark="Filter..."
                            Style="{StaticResource TextBoxFilter}"
                            Text="{Binding TableFilter}" />

                        <DataGrid
                            Grid.Row="3"
                            ItemsSource="{Binding Tables}"
                            SelectedItem="{Binding SelectedTable}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Schema}"
                                    Header="Schema" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!--  Columns  -->
                <Border Grid.Column="1" Style="{StaticResource BorderStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <Label
                            Grid.Row="0"
                            Content="Columns"
                            Style="{StaticResource Headline}" />

                        <Separator Grid.Row="1" />

                        <Grid
                            Grid.Row="2"
                            ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto,Auto" />

                        <DataGrid
                            Grid.Row="3"
                            AutoGenerateColumns="False"
                            ItemsSource="{Binding Columns}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn
                                    Width="50"
                                    Binding="{Binding IsIncluded}"
                                    Header="Use" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding ColumnName}"
                                    Header="Column"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Property" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding CSharpTypeName}"
                                    Header="Type"
                                    IsReadOnly="True" />
                                <DataGridCheckBoxColumn
                                    Width="50"
                                    Binding="{Binding IsPrimaryKey}"
                                    Header="Key" />
                                <DataGridCheckBoxColumn
                                    Width="60"
                                    Binding="{Binding IsNullable}"
                                    Header="Null" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Separator Grid.Row="3" />

                        <Button
                            Grid.Row="4"
                            Width="75"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveAliasesCommand}"
                            Content="Save" />
                    </Grid>
                </Border>

                <!--  Code  -->
                <Border Grid.Column="2" Style="{StaticResource BorderStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <Label
                            Grid.Row="0"
                            Content="Code"
                            Style="{StaticResource Headline}" />

                        <Separator Grid.Row="1" />

                        <Grid
                            Grid.Row="2"
                            ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="Namespace:" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding NamespaceName, UpdateSourceTrigger=PropertyChanged}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Content="Class:" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Content="Property accessor:" />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                ItemsSource="{Binding Accessors}"
                                SelectedItem="{Binding SelectedAccessor}" />

                            <CheckBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Content="Use EF Core attributes"
                                IsChecked="{Binding UseEfCoreAttributes}" />

                            <CheckBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Content="Generate summary"
                                IsChecked="{Binding GenerateSummary}" />
                        </Grid>

                        <StackPanel
                            Grid.Row="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Width="75"
                                Command="{Binding GenerateCodeCommand}"
                                Content="Generate" />
                        </StackPanel>

                        <avalonedit:TextEditor
                            x:Name="TextEditor"
                            Grid.Row="4"
                            Document="{Binding GeneratedCodeDocument}"
                            FontFamily="Hack,Consolas"
                            FontSize="13"
                            IsReadOnly="True"
                            ShowLineNumbers="True"
                            SyntaxHighlighting="C#" />

                        <Separator Grid.Row="5" />

                        <StackPanel
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Width="75"
                                Command="{Binding CopyCodeCommand}"
                                Content="Copy" />
                            <Button
                                Width="75"
                                Command="{Binding SaveCodeCommand}"
                                Content="Save" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
